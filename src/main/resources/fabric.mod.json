{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name_spaced}",
  "description": "${mod_description}",
  "authors": [],
  "license": "${license}",
  "contact": {
    "homepage": "${curseforge_page}",
    "sources": "${homepage}",
    "issues": "${homepage}/issues"
  },
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "${maven_group}.${mod_id}.Main"
    ],
    "client": [
      "${maven_group}.${mod_id}.client.Client"
    ]
  },
  "mixins": [
    "${mod_name}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}",
    "fabric-api": ">=${loader_min_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "${modrinth_page}",
        "modmenu.curseforge": "${curseforge_page}"
      }
    }
  }
}
