{
  "schemaVersion": 1,
  "id": "bplb",
  "version": "${mod_version}",
  "name": "Better Player Locator Bar",
  "description": "BetterPlayerLocatorBar is a Minecraft Fabric mod that adds a HUD bar above the experience bar, displaying colored icons representing nearby players.",
  "authors": [
    "Bichal"
  ],
  "license": "${license}",
  "contact": {
    "homepage": "${curseforge_page}",
    "sources": "${homepage}",
    "issues": "${homepage}/issues"
  },
  "icon": "assets/bplb/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.bichal.bplb.Main"
    ],
    "client": [
      "net.bichal.bplb.client.Client"
    ],
    "modmenu": [
      "net.bichal.bplb.integration.ModMenuImpl"
    ]
  },
  "mixins": [
    "BetterPlayerLocateBar.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=21",
    "fabric-api": "${loader_min_version}"
  },
  "custom": {
    "modmenu": {
      "modmenu": {
        "links": {
          "modmenu.modrinth": "${modrinth_page}",
          "modmenu.curseforge": "${curseforge_page}"
        }
      }
    }
  }
}
