{
  "schemaVersion": 1,
  "id": "bplb",
  "version": "${version}",
  "name": "Better Player Locator Bar",
  "description": "BetterPlayerLocatorBar is a Minecraft Fabric mod that adds a HUD bar above the experience bar, displaying colored icons representing nearby players.",
  "authors": [
    "Bichal",
    "Jorget"
  ],
  "license": "CC-BY-NC-SA-4.0",
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/better-player-locator-bar",
    "sources": "https://github.com/bichal/BetterPlayerLocatorBar",
    "issues": "https://github.com/bichal/BetterPlayerLocatorBar/issues"
  },
  "icon": "assets/bplb/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.bichal.bplb.Main"
    ],
    "client": [
      "net.bichal.bplb.client.Client"
    ],
    "modmenu": [
      "net.bichal.bplb.integration.ModMenuImpl"
    ]
  },
  "mixins": [
    "BetterPlayerLocateBar.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21.4 <=1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.115.0"
  },
  "custom": {
    "modmenu": {
      "modmenu": {
        "links": {
          "modmenu.modrinth": "https://www.curseforge.com/minecraft/mc-mods/better-player-locator-bar",
          "modmenu.curseforge": "https://modrinth.com/mod/bplb"
        }
      }
    }
  }
}
